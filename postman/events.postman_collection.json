        "url": "{{baseUrl}}/transactions/deposit",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountId\": \"{{fromId}}\",\n  \"amount\": \"100.00\",\n  \"currency\": \"BAM\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 202', () => pm.response.to.have.status(202));",
              "pm.collectionVariables.set('fundingId',pm.response.json().id);",
              "pm.test('Durable pending request', () => pm.expect(pm.response.json().status).to.eql('PENDING'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Poll Fund account",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Correlation-ID",
            "value": "{{eventCorrelation}}"
          }
        ],
        "url": "{{baseUrl}}/transactions/{{fundingId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const r=pm.response.json();",
              "if(r.status==='PENDING'){const n=Number(pm.collectionVariables.get('pollCount')||0)+1;pm.collectionVariables.set('pollCount',n);",
              "if(n<=100){pm.execution.setNextRequest('Poll Fund account');}else{pm.test('Polling deadline',()=>pm.expect.fail('Command stayed PENDING'));pm.execution.setNextRequest(null);}",
              "}else{pm.collectionVariables.set('pollCount',0);pm.test('Terminal status',()=>pm.expect(r.status).to.eql('COMPLETED'));}"
            ]
          }
        }
      ]
    },
