              "pm.collectionVariables.set('drainBId',pm.response.json().id);",
              "pm.test('Durable pending request', () => pm.expect(pm.response.json().status).to.eql('PENDING'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Poll Drain target",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Correlation-ID",
            "value": "{{eventCorrelation}}"
          }
        ],
        "url": "{{baseUrl}}/transactions/{{drainBId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const r=pm.response.json();",
              "if(r.status==='PENDING'){const n=Number(pm.collectionVariables.get('pollCount')||0)+1;pm.collectionVariables.set('pollCount',n);",
              "if(n<=100){pm.execution.setNextRequest('Poll Drain target');}else{pm.test('Polling deadline',()=>pm.expect.fail('Command stayed PENDING'));pm.execution.setNextRequest(null);}",
              "}else{pm.collectionVariables.set('pollCount',0);pm.test('Terminal status',()=>pm.expect(r.status).to.eql('COMPLETED'));}"
            ]
          }
        }
      ]
    },
    {
      "name": "Close toId",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Correlation-ID",
            "value": "{{eventCorrelation}}"
          }
        ],
        "url": "{{baseUrl}}/accounts/{{toId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"CLOSED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Closed zero account',()=>{pm.expect(pm.response.json().status).to.eql('CLOSED');pm.expect(pm.response.json().balance).to.eql(0);});"
            ]
          }
        }
      ]
    },
    {
      "name": "Deactivate synthetic customer",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Correlation-ID",
            "value": "{{eventCorrelation}}"
          }
        ],
        "url": "{{baseUrl}}/customers/{{customerId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Poll correlated notifications",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/notifications?correlationId={{eventCorrelation}}&size=100"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "const rows=pm.response.json().items;",
              "if(rows.length<9){const n=Number(pm.collectionVariables.get('eventPoll')||0)+1;pm.collectionVariables.set('eventPoll',n);if(n<100)pm.execution.setNextRequest('Poll correlated notifications');else pm.test('Notifications arrive',()=>pm.expect(rows.length).to.eql(9));}",
              "else {pm.test('Nine unique correlated notifications',()=>{pm.expect(rows.length).to.eql(9);pm.expect(new Set(rows.map(r=>r.id)).size).to.eql(9);rows.forEach(r=>{pm.expect(r.event.correlationId).to.eql(pm.collectionVariables.get('eventCorrelation'));pm.expect(r.event.version).to.eql(1);});});",
              "const counts={};rows.forEach(r=>counts[r.event.eventType]=(counts[r.event.eventType]||0)+1);pm.test('Expected business outcomes',()=>pm.expect(counts).to.deep.eql({CUSTOMER_CREATED:1,ACCOUNT_CREATED:2,TRANSACTION_COMPLETED:5,TRANSACTION_FAILED:1}));pm.collectionVariables.set('notificationId',rows[0].id);}"
            ]
          }
        }
      ]
    },
