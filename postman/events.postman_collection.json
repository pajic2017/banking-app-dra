{
  "info": {
    "name": "Banking Phase 5 \u2014 events and notifications",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Development workflow: monetary lifecycle, nine correlated notifications and retained dead-letter inspection. Drains and closes synthetic accounts."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    }
  ],
  "item": [
    {
      "name": "Create customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Correlation-ID",
            "value": "{{eventCorrelation}}"
          }
        ],
        "url": "{{baseUrl}}/customers",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"PostmanMoney\",\n  \"lastName\": \"Test\",\n  \"email\": \"money-{{runId}}@example.com\",\n  \"phone\": \"+38761123456\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('customerId',pm.response.json().id);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('runId',pm.variables.replaceIn('{{$guid}}'));",
              "pm.collectionVariables.set('pollCount',0);",
              "pm.collectionVariables.set('eventCorrelation',pm.variables.replaceIn('{{$guid}}'));",
              "pm.collectionVariables.set('eventPoll',0);"
            ]
          }
        }
      ]
    },
