{
  "info": {
    "name": "Banking Phase 3 \u2014 Account lifecycle",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Development data only; run sequentially. Leaves closed accounts and an inactive synthetic customer."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "currentId",
      "value": ""
    },
    {
      "key": "savingsId",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/customers",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"AccountPostman\",\n  \"lastName\": \"Test\",\n  \"email\": \"{{email}}\",\n  \"phone\": \"+38761123456\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"email\", \"account-postman-\"+pm.variables.replaceIn(\"{{$guid}}\")+\"@example.com\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code===201) pm.collectionVariables.set(\"customerId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create CURRENT account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/accounts",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"accountType\": \"CURRENT\",\n  \"currency\": \"BAM\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code===201) pm.collectionVariables.set(\"currentId\", pm.response.json().id);",
              "pm.test(\"Zero balance\", () => pm.expect(pm.response.json().balance).to.eql(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create SAVINGS account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/accounts",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"accountType\": \"SAVINGS\",\n  \"currency\": \"BAM\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code===201) pm.collectionVariables.set(\"savingsId\", pm.response.json().id);",
              "pm.test(\"Zero balance\", () => pm.expect(pm.response.json().balance).to.eql(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read account",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/accounts/{{currentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read balance",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/accounts/{{currentId}}/balance"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"BAM zero balance\", () => {pm.expect(pm.response.json().currency).to.eql(\"BAM\");pm.expect(pm.response.json().balance).to.eql(0);});"
            ]
          }
        }
      ]
    },
    {
      "name": "Customer accounts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/accounts/customer/{{customerId}}?size=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Two accounts\", () => pm.expect(pm.response.json().totalElements).to.eql(2));"
            ]
          }
        }
      ]
    },
    {
      "name": "Customer overview",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/customers/{{customerId}}/accounts"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Two account overview\", () => pm.expect(pm.response.json().items.length).to.eql(2));"
            ]
          }
        }
      ]
    },
    {
      "name": "Set current account BLOCKED",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/accounts/{{currentId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"BLOCKED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Status BLOCKED\", () => pm.expect(pm.response.json().status).to.eql(\"BLOCKED\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Set current account ACTIVE",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/accounts/{{currentId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Status ACTIVE\", () => pm.expect(pm.response.json().status).to.eql(\"ACTIVE\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Set current account CLOSED",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/accounts/{{currentId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"CLOSED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Status CLOSED\", () => pm.expect(pm.response.json().status).to.eql(\"CLOSED\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Set current account CLOSED",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/accounts/{{currentId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"CLOSED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Status CLOSED\", () => pm.expect(pm.response.json().status).to.eql(\"CLOSED\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject reopening",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/accounts/{{currentId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "Close savings account",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/accounts/{{savingsId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"CLOSED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Deactivate customer",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/customers/{{customerId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject account for inactive customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/accounts",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"accountType\": \"CURRENT\",\n  \"currency\": \"BAM\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject unsupported currency",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/accounts",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"accountType\": \"CURRENT\",\n  \"currency\": \"ZZZ\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  }
}
